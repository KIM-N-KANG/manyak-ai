{
  "permissions": {
    "allow": [
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-create-pages",
      "mcp__claude_ai_Notion__notion-update-data-source",
      "mcp__claude_ai_Notion__notion-search",
      "Bash(gh api *)",
      "Bash(claude plugin *)",
      "Bash(bash .agents/skills/release-deploy/scripts/qa.sh)",
      "Bash(bash .agents/skills/release-deploy/scripts/qa.sh *)",
      "Bash(bash .agents/skills/release-deploy/scripts/watch-deploy.sh)",
      "Bash(bash .agents/skills/release-deploy/scripts/watch-deploy.sh *)",
      "Bash(bash .agents/skills/release-deploy/scripts/prod-health.sh)",
      "Bash(bash .agents/skills/release-deploy/scripts/prod-health.sh *)",
      "Bash(bash .agents/skills/release-deploy/scripts/infra-check.sh)",
      "Bash(bash .agents/skills/release-deploy/scripts/infra-check.sh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-destructive-clean.py\"",
            "statusMessage": "파괴적 git clean 차단 확인"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-start.sh\"",
            "statusMessage": "하네스 규칙·제품 스펙(product-specs 전체) 전문 로드"
          }
        ]
      }
    ]
  }
}
