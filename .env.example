APP_NAME="AI Service"
APP_VERSION="0.5.0"
DEBUG=false

GEMINI_API_KEY=

# 기본 설정은 OpenAI·Gemini·DeepSeek API 키가 모두 필요하다.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
STORY_COMPILE_MODEL=gpt-5.6-terra
STORYLINES_MODEL=deepseek-flash
# 본문 모델·추론 강도는 요청별 라우팅으로 선택한다. CHAT_MODEL·CHAT_REASONING_EFFORT는 사용하지 않는다.
# 선택지 모델은 본문과 별도로 지정한다.
# 값을 빈칸으로 두면(`CHAT_CHOICE_MODEL=`) 기본값이 아니라 빈 모델 이름이 돼 서버가 뜨지 않는다.
CHAT_CHOICE_MODEL=deepseek-flash

# Jev 저장 이미지 선택(KNK-1505). 키가 없으면 이미지 선택 실패로 처리한다.
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0

# OpenAI (KNK-703) — 등록 모델: gpt-5.6-terra, gpt-5.6-luna, gpt-6-luna, gpt-5.4-mini
# 기본 STORY_COMPILE_MODEL이 Terra라 기본 설정으로 기동할 때 필요하다.
# MODEL env 어디에서도 OpenAI 모델을 하나도 고르지 않을 때만 비워도 서버가 뜬다.
# URL은 비워두면 SDK 기본 주소를 쓴다 — 값을 적으려면 http:// 또는 https://로 시작해야 한다.
OPENAI_API_KEY=
# OPENAI_API_URL=

# 자식 이미지의 부모 사진을 내려받을 CDN 호스트(JSON 배열). HTTPS만 허용하며 리다이렉트는 거부한다.
# IMAGE_PARENT_ALLOWED_HOSTS=["cdn.manyak.app","dev-cdn.manyak.app"]
# 자식 이미지 직접 업로드: 백엔드가 발급하는 실제 S3 호스트로 설정. 빈 배열이면 업로드 거부.
# IMAGE_UPLOAD_ALLOWED_HOSTS=[]

# Anthropic (KNK-675, KNK-703) — 등록 모델: claude-sonnet-5
# 비워도 서버가 뜬다: 위 MODEL env에서 Anthropic 모델을 고를 때만 필요하다.
# URL은 비워두면 SDK 기본 주소를 쓴다 — 값을 적으려면 http:// 또는 https://로 시작해야 한다.
ANTHROPIC_API_KEY=
# ANTHROPIC_API_URL=

# 오픈소스 계열(KNK-1628) — 등록 모델: qwen3.8-max, qwen3.8-flash(OpenRouter 중계), glm-5.2(Z.ai), kimi-k3(Moonshot)
# 비워도 서버가 뜬다: MODEL env에서 그 회사 모델을 고를 때만 필요하다. 채팅 본문은 layer·general 둘 다 고를 수 있다.
# URL 기본값은 각 회사의 OpenAI 호환 주소다 — 바꿀 때만 적는다.
# 키는 원래 이름 줄이 없으면 *_API_KEY_DEV를 읽는다(grid search 전용이라 운영 키가 없다).
# 원래 이름을 빈 값으로 적어 두면(`ALIBABA_API_KEY=`) 빈 키로 읽혀 _DEV로 넘어가지 않으니 주석으로 둔다.
# ALIBABA_API_KEY=
# ALIBABA_API_KEY_DEV=
# ALIBABA_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# ZAI_API_KEY=
# ZAI_API_KEY_DEV=
# ZAI_API_URL=https://api.z.ai/api/paas/v4
# MOONSHOT_API_KEY=
# MOONSHOT_API_KEY_DEV=
# MOONSHOT_API_URL=https://api.moonshot.ai/v1
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_DEV=
# OPENROUTER_API_URL=https://openrouter.ai/api/v1

# Sentry (KNK-262) — DSN 비우면 비활성(no-op). prod에서만 채운다.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0

# Langfuse LLM 관측 (KNK-624) — 키 비우면 비활성(no-op). 로컬·CI는 비운다.
# Sentry와 달리 프롬프트·응답 원문을 전송한다(원문 수집 정책 개정 동반 — 6-analytics §6-7).
# HOST는 JP(https://jp.cloud.langfuse.com)만 허용된다 — 원문 수집은 JP·prod 조건에서만 열려 있고
# (6-analytics §6-7), 활성화 가드가 그 밖의 값이면 켜지 않는다(KNK-652, design/3-ai-server-design.md §3-3).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
