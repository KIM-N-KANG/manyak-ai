APP_NAME="AI Service"
APP_VERSION="0.2.2"
DEBUG=false

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
STORY_COMPILE_MODEL=deepseek-v4-pro
STORYLINES_MODEL=deepseek-v4-flash
CHAT_MODEL=deepseek-v4-flash

# Anthropic (KNK-675) — 어댑터만 있고 이 공급자를 쓰는 모델은 아직 등록되지 않았다.
# 비워도 서버가 뜬다: 기동 검사는 위 세 모델이 실제로 쓰는 공급자의 키만 본다.
# URL은 비워두면 SDK 기본 주소를 쓴다 — 값을 적으려면 http:// 또는 https://로 시작해야 한다.
ANTHROPIC_API_KEY=
# ANTHROPIC_API_URL=

# Sentry (KNK-262) — DSN 비우면 비활성(no-op). prod에서만 채운다.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0

# Langfuse LLM 관측 (KNK-624) — 키 비우면 비활성(no-op). 로컬·CI는 비운다.
# Sentry와 달리 프롬프트·응답 원문을 전송한다(원문 수집 정책 개정 동반 — 6-analytics §6-7).
# HOST는 JP(https://jp.cloud.langfuse.com)만 허용된다 — 원문 수집은 JP·prod 조건에서만 열려 있고
# (6-analytics §6-7), 활성화 가드가 그 밖의 값이면 켜지 않는다(KNK-652, 5-ai-server §5-6).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
