APP_NAME="AI Service"
APP_VERSION="0.2.5"
DEBUG=false

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# 기본 설정은 컴파일에 OpenAI Terra, 스토리라인·채팅에 DeepSeek을 쓰므로 두 API 키가 모두 필요하다.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
STORY_COMPILE_MODEL=gpt-5.6-terra
STORYLINES_MODEL=deepseek-v4-flash
CHAT_MODEL=deepseek-v4-flash

# OpenAI (KNK-703) — 등록 모델: gpt-5.6-terra, gpt-5.6-luna, gpt-5.4-mini
# 기본 STORY_COMPILE_MODEL이 Terra라 기본 설정으로 기동할 때 필요하다.
# 세 MODEL env에서 OpenAI 모델을 하나도 고르지 않을 때만 비워도 서버가 뜬다.
# URL은 비워두면 SDK 기본 주소를 쓴다 — 값을 적으려면 http:// 또는 https://로 시작해야 한다.
OPENAI_API_KEY=
# OPENAI_API_URL=

# Anthropic (KNK-675, KNK-703) — 등록 모델: claude-sonnet-5
# 비워도 서버가 뜬다: 위 세 MODEL env에서 Anthropic 모델을 고를 때만 필요하다.
# URL은 비워두면 SDK 기본 주소를 쓴다 — 값을 적으려면 http:// 또는 https://로 시작해야 한다.
ANTHROPIC_API_KEY=
# ANTHROPIC_API_URL=

# Sentry (KNK-262) — DSN 비우면 비활성(no-op). prod에서만 채운다.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0

# Langfuse LLM 관측 (KNK-624) — 키 비우면 비활성(no-op). 로컬·CI는 비운다.
# Sentry와 달리 프롬프트·응답 원문을 전송한다(원문 수집 정책 개정 동반 — 6-analytics §6-7).
# HOST는 JP(https://jp.cloud.langfuse.com)만 허용된다 — 원문 수집은 JP·prod 조건에서만 열려 있고
# (6-analytics §6-7), 활성화 가드가 그 밖의 값이면 켜지 않는다(KNK-652, 5-ai-server §5-6).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
