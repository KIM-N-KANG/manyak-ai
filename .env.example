APP_NAME="AI Service"
APP_VERSION="0.1.0"
DEBUG=false

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
STORY_COMPILE_MODEL=deepseek-v4-pro
STORYLINES_MODEL=deepseek-v4-flash
CHAT_MODEL=deepseek-v4-flash

# Sentry (KNK-262) — DSN 비우면 비활성(no-op). prod에서만 채운다.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0

# Langfuse LLM 관측 (KNK-624) — 키 비우면 비활성(no-op). 로컬·CI는 비운다.
# Sentry와 달리 프롬프트·응답 원문을 전송한다(원문 수집 정책 개정 동반 — 6-analytics §6-7).
# HOST는 가입 리전을 따른다(us: cloud / eu: eu.cloud / jp: jp.cloud .langfuse.com).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
